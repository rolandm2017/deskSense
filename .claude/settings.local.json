{
  "permissions": {
    "allow": [
      "Bash(cat:*)",
      "Bash(ls:*)",
      "Bash(mkdir:*)",
      "Bash(npm install:*)",
      "Bash(npx tsc:*)",
      "Bash(npm run test:run:*)",
      "Bash(npx svelte-check:*)",
      "Bash(tree:*)",
      "Bash(xargs:*)",
      "Bash(find:*)",
      "Bash(python3:*)",
      "Bash(iconv:*)",
      "Bash(git mv:*)",
      "WebSearch",
      "Bash(grep:*)",
      "WebFetch(domain:api.forvo.com)",
      "WebFetch(domain:github.com)",
      "Bash(~/bin/win-pytest:*)"
    ],
    "deny": [
      "Read(**/.env*)",
      "Read(**/*.env*)",
      "Read(./.env)",
      "Read(./*.env)",
      "Read(/development.env)",
      "Read(/*.env)",
      "Read(/.env.*)"
    ]
  }
}
